# Deployer key for Arbitrum Sepolia. Use a throwaway testnet account — never a key that holds
# mainnet funds. Fund it from one of the faucets listed in the README before deploying.
PRIVATE_KEY=0x

# RPC used by `forge script --rpc-url $ARBITRUM_SEPOLIA_RPC_URL`.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Free key from https://arbiscan.io/myapikey — only needed for `forge verify-contract`.
ARBISCAN_API_KEY=
