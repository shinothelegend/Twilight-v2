# All optional. The app works with none of them set — these only improve reliability and history
# coverage. No secret is required to run the dashboard.

# Dedicated Arbitrum Sepolia RPC (Alchemy/Infura free tier). Falls back to the public endpoints.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# WalletConnect project id from https://cloud.reown.com. Without it, injected wallets
# (MetaMask, Rabby, Brave) and Coinbase Wallet still work; only the QR flow is unavailable.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arbiscan/Etherscan v2 key. Native ETH transfers emit no logs, so they can only be listed with
# an indexer. Without this, Recent transactions covers token and staking activity only, and the
# panel says so.
NEXT_PUBLIC_ARBISCAN_API_KEY=
